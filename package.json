{
  "name": "python-pal",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "description": "Python Pal — bilingual Python learning for beginners",
  "author": "ForgeFront Systems",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder --win nsis",
    "dist:appx": "vite build && electron-builder --win appx",
    "assets:store": "python store-submission/_generate_store_assets.py",
    "cap:android": "vite build && cap sync android && cap open android",
    "cap:ios": "vite build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.2",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "ForgeFrontSystems.PythonPal",
    "productName": "Python Pal",
    "copyright": "Copyright © 2026 ForgeFront Systems",
    "directories": {
      "output": "release",
      "buildResources": "electron/buildResources"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs"
    ],
    "win": {
      "target": ["appx"],
      "icon": "public/icon.ico"
    },
    "appx": {
      "identityName": "ForgeFrontSystems.PythonPal",
      "publisher": "CN=8E906094-1F36-496B-A889-858E25A1FCB3",
      "publisherDisplayName": "ForgeFront Systems",
      "applicationId": "PythonPal",
      "displayName": "Python Pal",
      "languages": ["en-US"],
      "backgroundColor": "#0A0A0A",
      "showNameOnTiles": true
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.png",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png",
      "category": "Education"
    }
  }
}
